rules_version = '2';

// Reflekt — Firestore Security Rules
// Pattern: every journal entry lives under users/{uid}/entries and only the
// signed-in owner (Anonymous Auth uid) may read or write their own entries.
// Everything else is denied.
//
// STATUS: prepared in the repo, NOT yet active on the project.
// Activate via Firebase Console -> Firestore Database -> Rules -> paste ->
// Publish, or later via `firebase deploy --only firestore:rules` together
// with the Hosting deploy.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/entries/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
